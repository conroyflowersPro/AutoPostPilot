# Supabase (public — safe in client)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Server-side only — set these in:
#   1) Netlify environment variables (for remaining Next API routes)
#   2) Supabase Edge Function secrets (for generate-post)
# Never put real keys in this file or commit them.
XAI_API_KEY=your_xai_key_here
OPENAI_API_KEY=your_openai_key_here
FEDICA_API_TOKEN=your_fedica_token_here
